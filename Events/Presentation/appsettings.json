{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=events;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Key": "SecretKey_Standard_Length_32_Chars",
    "Issuer": "YaEvents",
    "Audience": "YaEvents",
    "Expires": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "booking-processing"
  },
  "Redis": {
    "Connection": "localhost:6379",
    "ConnectTimeout": 5000,
    "SyncTimeout": 3000,
    "ConnectRetry": 3,
    "Password": "password",
    "TTL": {
      "Event": 1,
      "TopTenEvents": 60
    }
  }
}
